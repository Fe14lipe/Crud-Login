# Copia este archivo como .env y completa los valores. El archivo .env NO se sube a Git.
PORT=3000
ADMIN_USER=tu_usuario
# Hash MD5 de tu contraseña. Generar con:
# node -e "console.log(require('crypto').createHash('md5').update('TU_CONTRASEÑA').digest('hex'))"
ADMIN_PASSWORD_HASH=
# Cadena larga y aleatoria. Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# PostgreSQL (la base se crea en pgAdmin 4 y se carga con db/schema.sql)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=pomasqui_stream
